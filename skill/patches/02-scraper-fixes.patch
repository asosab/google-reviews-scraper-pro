+    def _wheel_scroll(self, driver: Chrome, pane: WebElement) -> bool:
+        """
+        Trigger the reviews list's lazy loader with a native mouse-wheel event
+        over the pane center (CDP). Google Maps ignores programmatic
+        scrollTop/scrollBy for infinite loading; a real wheel event works.
+        """
+        try:
+            rect = driver.execute_script(
+                "const r=arguments[0].getBoundingClientRect();"
+                "return {x:Math.round(r.x+r.width/2), y:Math.round(r.y+r.height/2)};",
+                pane,
+            )
+            driver.execute_cdp_cmd(
+                "Input.dispatchMouseEvent",
+                {
+                    "type": "mouseWheel",
+                    "x": rect["x"],
+                    "y": rect["y"],
+                    "deltaX": 0,
+                    "deltaY": 1200,
+                },
+            )
+            return True
+        except Exception as e:  # noqa: BLE001
+            log.warning(f"CDP wheel scroll failed: {e}")
+            return False
+
