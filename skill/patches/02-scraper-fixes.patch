+        fast_deadline = time.time() + 10
+        while time.time() < fast_deadline:
+            try:
+                tabs = driver.find_elements(By.CSS_SELECTOR, '[role="tab"]')
+                target = None
+                for tab in tabs:
+                    label = f"{tab.text or ''} {tab.get_attribute('aria-label') or ''}".lower()
+                    if any(w in label for w in keywords):
+                        target = tab
+                        break
+                if target is not None:
+                    try:
+                        target.click()
+                    except Exception:
+                        driver.execute_script("arguments[0].click();", target)
+                    time.sleep(2)
+                    log.info(f"Clicked reviews tab via text match: '{target.text}'")
+                    return True
+            except Exception as fast_err:  # noqa: BLE001
+                log.debug(f"Reviews tab fast-path failed: {fast_err}")
+            time.sleep(0.5)
